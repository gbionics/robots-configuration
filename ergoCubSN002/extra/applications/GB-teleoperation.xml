<application>
    <name>GB-teleoperation</name>

    <module>
        <name>yarprobotinterface</name>
        <parameters>--config iFeelSuit.xml --node-list "(4 5 6 7 8)" --serial-port-name COM4</parameters>
        <environment>YARP_FORWARD_LOG_ENABLE=1</environment>
        <description>Run iFeelSuit driver</description>
        <node>teleop</node>
        <tag>iFeelSuit</tag>
    </module>

    <module>
        <name>yarpdev</name>
        <parameters>--device frameTransformServer --filexml_option fts_yarp_only.xml</parameters>
        <node>teleop</node>
    </module>

    <module>
        <name>yarprobotinterface</name>
        <parameters>--config ManusGlove.xml</parameters>
        <environment>YARP_FORWARD_LOG_ENABLE=0</environment>
        <description>Run SenseGlove Wearable Device</description>
        <node>teleop</node>
        <tag>SenseGlove</tag>
    </module>
</application>