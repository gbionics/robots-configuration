<?xml version="1.0" encoding="UTF-8" ?>
<device xmlns:xi="http://www.w3.org/2001/XInclude" name="all_joints-mc" type="CiA402MotionControl">

    <param name="ifname">"enx08beac20d80f"</param>
    <param name="num_axes">2</param>
    <param name="period">2.5e-4</param>
    <param name="pdo_timeout_us">10000</param>
    <param name="enable_dc">false</param>
    <!-- Joint Names:                               r_ankle_m4  r_ankle_m5   -->
    <param name="axes_names">                      ("r_ankle_m4", "r_ankle_m5")</param>
    <param name="inverted_motion_sense_direction"> (        false,          true)</param>
 
    <!-- 0x2002 position control strategy: true => 1 (Simple PID), false => 2 (Cascaded PID) -->
    <param name="use_simple_pid_mode">                true                           </param>
    <param name="simple_pid_kp_nm_per_deg">        (        0.6981,        0.6981      )</param>
    <param name="simple_pid_kd_nm_s_per_deg">      (        0.0117,        0.0117      )</param>

    <param name="pos_limit_min_deg">               (        -50.0,          -50.0 )</param>
    <param name="pos_limit_max_deg">               (         40.0,           40.0      )</param>
    <param name="use_position_limits_from_config"> (         true,           true      )</param>

    <param name="enc1_mount">                      (      "motor",        "motor")</param>
    <param name="enc2_mount">                      (      "joint",        "joint")</param>
    <param name="position_feedback_motor">         (       "6064",         "6064")</param>
    <param name="velocity_feedback_motor">         (       "606C",         "606C")</param>
    <param name="position_feedback_joint">         (       "6064",         "6064")</param>
    <param name="velocity_feedback_joint">         (       "606C",         "606C")</param>

    <param name="position_window_deg">             (         0.1,            0.1)</param>
    <param name="timing_window_ms">                (         100,            100)</param>
</device>
