<?xml version="1.0" encoding="UTF-8"?>
<device xmlns:xi="http://www.w3.org/2001/XInclude" name="right-rsu_ankle-decoupler" type="rsuAnkleDecouplerDevice">
    <param name="use_urdf_model">true</param>
    <param name="urdf_filename">model.urdf</param>
    <param name="decouplers">("right")</param>

    <group name="right">
        <param name="joint_names">("r_ankle_m4", "r_ankle_m5")</param>
        <param name="output_joint_names">("r_ankle_roll", "r_ankle_pitch")</param>
        <param name="joint_limits_min">(-10.0, -50.0)</param>
        <param name="joint_limits_max">(10.0, 25.0)</param>

        <param name="frame_W">r_shank</param>
        <param name="frame_M1">r_crank_top</param>
        <param name="frame_M2">r_crank_bottom</param>
        <param name="frame_S1">r_gimbal1_yoke</param>
        <param name="frame_S2">r_gimbal2_yoke</param>
        <param name="frame_F1">r_anklecr_in</param>
        <param name="frame_F2">r_anklecr_out</param>
        <param name="frame_F">r_ankle_2</param>
    </group>

    <action phase="startup" level="5" type="attach">
        <paramlist name="networks">
            <elem name="device"> right-all_joints-mc  </elem>
        </paramlist>
    </action>
    <action phase="shutdown" level="20" type="detach" />
</device>
