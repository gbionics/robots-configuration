<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE devices PUBLIC "-//YARP//DTD yarprobotinterface 3.0//EN" "http://www.yarp.it/DTD/yarprobotinterfaceV3.0.dtd">

<device xmlns:xi="http://www.w3.org/2001/XInclude" name="all_joints-mc_remapper" type="controlboardremapper">
    <param name="axesNames">("l_hip_pitch", "l_hip_roll", "l_hip_yaw", "l_knee", "l_ankle_pitch", "l_ankle_roll", "r_hip_pitch", "r_hip_roll", "r_hip_yaw", "r_knee", "r_ankle_pitch", "r_ankle_roll")</param>
    <param name="joints"> 12 </param>
    <action phase="startup" level="8" type="attach">
        <paramlist name="networks">
            <elem name="left_joints"> left_leg-mc_remapper </elem>
            <elem name="right_joints"> right_leg-mc_remapper </elem>
        </paramlist>
    </action>
    <action phase="shutdown" level="20" type="detach" />
</device>